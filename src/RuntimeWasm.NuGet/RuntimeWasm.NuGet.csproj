<Project Sdk="Microsoft.Build.NoTargets/3.7.134">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <PackageId>Itexoft.dotnet.runtime.wasm</PackageId>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <LangVersion>latest</LangVersion>
        <RepositoryType>git</RepositoryType>
        <Authors>Denis Kudelin</Authors>
        <Company>Itexoft</Company>
        <Copyright>$(Authors)</Copyright>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/Itexoft/runtime-wasm</RepositoryUrl>
        <PackageProjectUrl>https://github.com/Itexoft/runtime-wasm</PackageProjectUrl>
        <Description>Prebuilt dotnet.native.wasm variants for browser-wasm.</Description>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <EnableSymbols>false</EnableSymbols>
        <IncludeSymbols Condition="'$(EnableSymbols)' == 'true'">true</IncludeSymbols>
        <SymbolPackageFormat Condition="'$(EnableSymbols)' == 'true'">snupkg</SymbolPackageFormat>

        <VersionFile>$(MSBuildThisFileDirectory)../../VERSION</VersionFile>
        <VersionFromFile Condition="Exists('$(VersionFile)')">$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</VersionFromFile>
        <Version Condition="'$(VersionFromFile)' != ''">$(VersionFromFile)</Version>
        <PackageVersion Condition="'$(VersionFromFile)' != ''">$(VersionFromFile)</PackageVersion>
        <AssemblyVersion Condition="'$(VersionFromFile)' != ''">$(VersionFromFile)</AssemblyVersion>
        <FileVersion Condition="'$(VersionFromFile)' != ''">$(VersionFromFile)</FileVersion>
        <BrowserWasmPackageRoot>runtimes/browser-wasm</BrowserWasmPackageRoot>
        <BrowserWasmLibPackagePath>$(BrowserWasmPackageRoot)/lib/net10.0</BrowserWasmLibPackagePath>
        <BrowserWasmNativePackageRoot>$(BrowserWasmPackageRoot)/native</BrowserWasmNativePackageRoot>

        <ArtifactsStMm1>$(ArtifactsRoot)/runtime-wasm-st-mm1</ArtifactsStMm1>
        <ArtifactsStMm2>$(ArtifactsRoot)/runtime-wasm-st-mm2</ArtifactsStMm2>
        <ArtifactsMtMm1>$(ArtifactsRoot)/runtime-wasm-mt-mm1</ArtifactsMtMm1>
        <ArtifactsMtMm2>$(ArtifactsRoot)/runtime-wasm-mt-mm2</ArtifactsMtMm2>
    </PropertyGroup>

    <Target Name="ValidateArtifactsRoot" BeforeTargets="Pack">
        <Error Condition="'$(ArtifactsRoot)' == ''" Text="ArtifactsRoot must be set for packing." />
        <Error Condition="!Exists('$(ArtifactsRoot)')" Text="ArtifactsRoot does not exist: $(ArtifactsRoot)" />
    </Target>

    <Target Name="ValidateArtifactLayout" BeforeTargets="Pack" DependsOnTargets="ValidateArtifactsRoot">
        <Error Condition="!Exists('$(ArtifactsStMm1)/lib/net10.0')" Text="Managed runtime lib directory not found: $(ArtifactsStMm1)/lib/net10.0" />
        <Error Condition="!Exists('$(ArtifactsStMm1)/native')" Text="Native runtime directory not found: $(ArtifactsStMm1)/native" />
        <Error Condition="!Exists('$(ArtifactsStMm2)/native')" Text="Native runtime directory not found: $(ArtifactsStMm2)/native" />
        <Error Condition="!Exists('$(ArtifactsMtMm1)/native')" Text="Native runtime directory not found: $(ArtifactsMtMm1)/native" />
        <Error Condition="!Exists('$(ArtifactsMtMm2)/native')" Text="Native runtime directory not found: $(ArtifactsMtMm2)/native" />
    </Target>

    <Target Name="ExcludeTransientPackItems" BeforeTargets="GenerateNuspec">
        <ItemGroup>
            <None Update="@(None)"
                  Pack="false"
                  Condition="
                    $([System.String]::Copy('%(None.Identity)').StartsWith('obj/')) Or
                    $([System.String]::Copy('%(None.Identity)').StartsWith('obj\\')) Or
                    $([System.String]::Copy('%(None.Identity)').StartsWith('bin/')) Or
                    $([System.String]::Copy('%(None.Identity)').StartsWith('bin\\')) Or
                    $([System.String]::Copy('%(None.PackagePath)').StartsWith('obj/')) Or
                    $([System.String]::Copy('%(None.PackagePath)').StartsWith('obj\\')) Or
                    $([System.String]::Copy('%(None.PackagePath)').StartsWith('bin/')) Or
                    $([System.String]::Copy('%(None.PackagePath)').StartsWith('bin\\'))" />
            <Content Update="@(Content)"
                     Pack="false"
                     Condition="
                       $([System.String]::Copy('%(Content.Identity)').StartsWith('obj/')) Or
                       $([System.String]::Copy('%(Content.Identity)').StartsWith('obj\\')) Or
                       $([System.String]::Copy('%(Content.Identity)').StartsWith('bin/')) Or
                       $([System.String]::Copy('%(Content.Identity)').StartsWith('bin\\')) Or
                       $([System.String]::Copy('%(Content.PackagePath)').StartsWith('obj/')) Or
                       $([System.String]::Copy('%(Content.PackagePath)').StartsWith('obj\\')) Or
                       $([System.String]::Copy('%(Content.PackagePath)').StartsWith('bin/')) Or
                       $([System.String]::Copy('%(Content.PackagePath)').StartsWith('bin\\'))" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="" Link="README.md"/>
    </ItemGroup>

    <ItemGroup>
        <RuntimeLib Include="$(ArtifactsStMm1)/lib/net10.0/**/*" />
        <None Include="@(RuntimeLib)" Pack="true" PackagePath="$(BrowserWasmLibPackagePath)/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <WasmNativeStMm1 Include="$(ArtifactsStMm1)/native/**/*" />
        <WasmNativeStMm2 Include="$(ArtifactsStMm2)/native/**/*" />
        <WasmNativeMtMm1 Include="$(ArtifactsMtMm1)/native/**/*" />
        <WasmNativeMtMm2 Include="$(ArtifactsMtMm2)/native/**/*" />
        <None Include="@(WasmNativeStMm1)" Pack="true" PackagePath="$(BrowserWasmNativePackageRoot)/singlethread/mm1/%(RecursiveDir)%(Filename)%(Extension)" />
        <None Include="@(WasmNativeStMm2)" Pack="true" PackagePath="$(BrowserWasmNativePackageRoot)/singlethread/mm2/%(RecursiveDir)%(Filename)%(Extension)" />
        <None Include="@(WasmNativeMtMm1)" Pack="true" PackagePath="$(BrowserWasmNativePackageRoot)/multithread/mm1/%(RecursiveDir)%(Filename)%(Extension)" />
        <None Include="@(WasmNativeMtMm2)" Pack="true" PackagePath="$(BrowserWasmNativePackageRoot)/multithread/mm2/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
